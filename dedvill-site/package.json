{
  "name": "dedvill-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-gallery-manifest.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/generate-gallery-manifest.mjs",
    "postbuild": "node -e \"require('fs').writeFileSync('dist/.nojekyll', '')\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.86.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "gh-pages": "^6.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.21"
  }
}
